{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4patent.local/schemas/ai4patent.schema.json",
  "title": "AIFPatent system configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["features", "model", "embedding", "rag", "storage", "workflow", "search"],
  "properties": {
    "$schema": {"type": "string"},
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patent_corpus", "initial_review_rag", "followup_rag"],
      "properties": {
        "patent_corpus": {"type": "boolean"},
        "initial_review_rag": {"type": "boolean"},
        "followup_rag": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"initial_review_rag": {"const": true}}, "required": ["initial_review_rag"]},
          "then": {"properties": {"patent_corpus": {"const": true}}}
        },
        {
          "if": {"properties": {"followup_rag": {"const": true}}, "required": ["followup_rag"]},
          "then": {"properties": {"initial_review_rag": {"const": true}}}
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "default", "base_url", "api_key_env", "timeout_seconds", "max_output_tokens", "structured_output_retries", "temperature"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "default": {"type": "string", "minLength": 1},
        "base_url": {"type": "string", "format": "uri"},
        "api_key_env": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 256},
        "structured_output_retries": {"type": "integer", "minimum": 0, "maximum": 10},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2}
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "provider", "model", "base_url", "api_key_env", "dimensions", "normalization", "batch_size", "timeout_seconds"],
      "properties": {
        "enabled": {"type": "boolean"},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "base_url": {"type": "string", "format": "uri"},
        "api_key_env": {"type": "string", "minLength": 1},
        "dimensions": {"type": "integer", "minimum": 1, "maximum": 65535},
        "normalization": {"const": "l2"},
        "batch_size": {"type": "integer", "minimum": 1, "maximum": 256},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "rag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hybrid"],
      "properties": {
        "hybrid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rrf_k", "lexical_limit", "vector_limit", "final_limit", "max_chunks_per_version", "max_chunks_per_section_label"],
          "properties": {
            "rrf_k": {"type": "integer", "minimum": 1, "maximum": 1000},
            "lexical_limit": {"type": "integer", "minimum": 1, "maximum": 50},
            "vector_limit": {"type": "integer", "minimum": 1, "maximum": 50},
            "final_limit": {"type": "integer", "minimum": 1, "maximum": 30},
            "max_chunks_per_version": {"type": "integer", "minimum": 1, "maximum": 30},
            "max_chunks_per_section_label": {"type": "integer", "minimum": 1, "maximum": 10}
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs_dir", "uploads_dir", "cache_dir", "cache"],
      "properties": {
        "runs_dir": {"type": "string", "minLength": 1},
        "uploads_dir": {"type": "string", "minLength": 1},
        "cache_dir": {"type": "string", "minLength": 1},
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_bytes", "low_watermark_bytes", "eviction_policy", "cleanup_after_write"],
          "properties": {
            "max_bytes": {"type": "integer", "minimum": 1},
            "low_watermark_bytes": {"type": "integer", "minimum": 0},
            "eviction_policy": {"const": "fifo"},
            "cleanup_after_write": {"type": "boolean"}
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_timeout_seconds", "max_step_attempts", "document_agent_concurrency", "inventive_route_concurrency", "resume_incomplete_runs_on_startup"],
      "properties": {
        "step_timeout_seconds": {"type": "integer", "minimum": 1},
        "max_step_attempts": {"type": "integer", "minimum": 1},
        "document_agent_concurrency": {"type": "integer", "minimum": 1},
        "inventive_route_concurrency": {"type": "integer", "minimum": 1},
        "resume_incomplete_runs_on_startup": {"type": "boolean"}
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providers", "default_mode", "modes", "saturation"],
      "properties": {
        "providers": {"$ref": "#/$defs/providers"},
        "default_mode": {"enum": ["quick", "standard", "deep"]},
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quick", "standard", "deep"],
          "properties": {
            "quick": {"$ref": "#/$defs/searchMode"},
            "standard": {"$ref": "#/$defs/searchMode"},
            "deep": {"$ref": "#/$defs/searchMode"}
          }
        },
        "saturation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["consecutive_rounds", "max_new_high_relevance_families"],
          "properties": {
            "consecutive_rounds": {"type": "integer", "minimum": 1},
            "max_new_high_relevance_families": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  },
  "$defs": {
    "providerBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serpapi_google_patents", "exa_mcp", "google_patents_local"],
      "properties": {
        "serpapi_google_patents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "timeout_seconds", "max_attempts", "endpoint", "api_key_file", "search_engine", "details_engine", "trust_environment_proxy", "fallback_to_direct"],
          "properties": {
            "enabled": {"type": "boolean"},
            "timeout_seconds": {"type": "integer", "minimum": 1},
            "max_attempts": {"type": "integer", "minimum": 1},
            "endpoint": {"type": "string", "format": "uri"},
            "api_key_file": {"type": "string", "minLength": 1},
            "search_engine": {"type": "string", "minLength": 1},
            "details_engine": {"type": "string", "minLength": 1},
            "trust_environment_proxy": {"type": "boolean"},
            "fallback_to_direct": {"type": "boolean"}
          }
        },
        "exa_mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "timeout_seconds", "max_attempts", "endpoint", "search_tool", "fetch_tool", "fetch_max_characters"],
          "properties": {
            "enabled": {"type": "boolean"},
            "timeout_seconds": {"type": "integer", "minimum": 1},
            "max_attempts": {"type": "integer", "minimum": 1},
            "endpoint": {"type": "string", "format": "uri"},
            "search_tool": {"type": "string", "minLength": 1},
            "fetch_tool": {"type": "string", "minLength": 1},
            "fetch_max_characters": {"type": "integer", "minimum": 10000, "maximum": 500000}
          }
        },
        "google_patents_local": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "timeout_seconds", "max_attempts", "base_url", "min_request_interval_seconds", "search_interval_min_seconds", "search_interval_max_seconds", "document_interval_min_seconds", "document_interval_max_seconds", "transient_failure_cooldown_seconds", "rate_limited_cooldown_seconds", "blocked_cooldown_min_seconds", "blocked_cooldown_max_seconds", "user_agent", "trust_environment_proxy", "fallback_to_direct"],
          "properties": {
            "enabled": {"type": "boolean"},
            "timeout_seconds": {"type": "integer", "minimum": 1},
            "max_attempts": {"type": "integer", "minimum": 1},
            "base_url": {"type": "string", "format": "uri"},
            "min_request_interval_seconds": {"type": "number", "minimum": 0},
            "search_interval_min_seconds": {"type": "number", "minimum": 0},
            "search_interval_max_seconds": {"type": "number", "minimum": 0},
            "document_interval_min_seconds": {"type": "number", "minimum": 0},
            "document_interval_max_seconds": {"type": "number", "minimum": 0},
            "transient_failure_cooldown_seconds": {"type": "integer", "minimum": 1},
            "rate_limited_cooldown_seconds": {"type": "integer", "minimum": 1},
            "blocked_cooldown_min_seconds": {"type": "integer", "minimum": 1},
            "blocked_cooldown_max_seconds": {"type": "integer", "minimum": 1},
            "user_agent": {"type": "string", "minLength": 1},
            "trust_environment_proxy": {"type": "boolean"},
            "fallback_to_direct": {"type": "boolean"}
          }
        }
      }
    },
    "searchMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_max", "deep_review_min", "deep_review_max"],
      "properties": {
        "candidate_max": {"type": "integer", "minimum": 10},
        "deep_review_min": {"type": "integer", "minimum": 10},
        "deep_review_max": {"type": "integer", "minimum": 10}
      }
    }
  }
}
